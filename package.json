{
  "name": "pi-web-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for pi-web: auto-starts the local server and hosts it in tabs",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "app": "electron-vite build && node scripts/run-app.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "shortcut:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1 -Desktop",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "check:theme": "node scripts/check-theme-probe.mjs",
    "check:status": "node scripts/check-tab-status-probe.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:status-model": "node --experimental-strip-types --no-warnings scripts/check-status-model.mjs",
    "check:split": "node --experimental-strip-types --no-warnings scripts/check-split.mjs",
    "check:compat": "node --experimental-strip-types --no-warnings scripts/check-compat.mjs",
    "check:notification": "node scripts/check-notification-patch.mjs",
    "check:status-manager": "node --experimental-strip-types --no-warnings scripts/check-tab-status-manager.mjs",
    "check:notification-bridge": "node --experimental-strip-types --no-warnings scripts/check-notification-bridge.mjs",
    "check:theme-manager": "node --experimental-strip-types --no-warnings scripts/check-theme-manager.mjs",
    "check:lifecycle": "node --experimental-strip-types --no-warnings scripts/check-tab-lifecycle.mjs",
    "check:tab-model": "node --experimental-strip-types --no-warnings scripts/check-tab-model.mjs",
    "check:runtime-update": "node --experimental-strip-types --no-warnings scripts/check-runtime-update.mjs",
    "check": "npm run typecheck && npm run check:contracts && npm run check:theme && npm run check:status && npm run check:status-model && npm run check:status-manager && npm run check:split && npm run check:compat && npm run check:notification && npm run check:notification-bridge && npm run check:theme-manager && npm run check:lifecycle && npm run check:tab-model && npm run check:runtime-update",
    "check:all": "npm run check && npm run smoke",
    "icons": "node scripts/build-icons.mjs",
    "dist": "electron-vite build && electron-builder --win portable",
    "dist:nsis": "electron-vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
